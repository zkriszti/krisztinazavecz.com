---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import MainNav from '../components/MainNav.astro';
import Social from '../components/Social.astro';
import { library, icon, type IconName, type IconDefinition } from "@fortawesome/fontawesome-svg-core";
import { faRss } from "@fortawesome/free-solid-svg-icons";
library.add(faRss);

const generateIconHtml = (iconName: IconName) => {
  const iconSvg = icon({ prefix: 'fas', iconName }).html;
  return iconSvg[0];
}
---
<header>
	<div class="header-inner">
		<div class="header-top">
			<a href="#" class="page-info">
				<span class="page-info-name">Krisztina Závecz</span>
				<span class="page-info-title">Frontend Developer</span>
			</a>
			<a href="feed://krisztinazavecz.com/rss.xml" class="rss-icon">
				<Fragment set:html={generateIconHtml("rss")} />
			</a>
		</div>
		<Social />
		<MainNav />
	</div>
</header>

<style lang="stylus">
header
	background: #446189
	padding-top: 15px

	.header-inner
		align-items: center
		margin-bottom: 20px
		display: grid
		grid-template-rows: repeat(3, auto)
		grid-auto-flow: column
		grid-row-gap: 10px
		font-family: var(--font-heading)
		padding: 0 20px
		a
			text-decoration: none
			.page-info-name,
			.page-info-title
					color: #eee
					display: block
			.page-info-name
				font-size: 1.3rem
				text-transform: uppercase
			.page-info-title
				font-size: 0.8em
				font-style: italic
			&:visited
				color: #444
			&.rss-icon
				color: #FFF
				:global(svg)
					width: 18px
					height: 18px

		.header-top
			display: flex
			justify-content: space-between

img
	max-width: 100%
</style>
