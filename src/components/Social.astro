---
import { library, icon, type IconName, type IconDefinition } from "@fortawesome/fontawesome-svg-core";
import { faGithub, faBluesky, faLinkedin } from "@fortawesome/free-brands-svg-icons";
library.add(faGithub, faBluesky, faLinkedin);

interface IconItem {
	iconName: IconName,
	target: string,
	icon: IconDefinition,
	aria: string,
}

const iconItems: IconItem[] = [
	{
		iconName: "bluesky",
		target: "https://bsky.app/profile/krisztinazavecz.com",
		icon: faBluesky,
		aria: "follow me on bluesky",
	},
	{
		iconName: "github",
		target: "https://github.com/zkriszti",
		icon: faGithub,
		aria: "my github account",
	},
	{
		iconName: "linkedin",
		target: "https://www.linkedin.com/in/krisztinazavecz",
		icon: faLinkedin,
		aria: "my LinkedIn account",
	},
]

const generateIconHtml = (iconName: IconName) => {
  const iconSvg = icon({ prefix: 'fab', iconName }).html;
  return iconSvg[0];
}
---
<div class="social">
	{iconItems && iconItems.map((item) => (<a
		href={item.target}
		target="_blank"
	>
		<Fragment set:html={generateIconHtml(item.iconName)} />
		<span class="sr-only">{item.aria}</span>
	</a>))}
</div>

<style lang="stylus">
a
	line-height: 0
	margin-right: 10px
	display: inline-flex
	img
		max-width: 100%
	:global(svg)
		width: 20px
		height: 20px
		:global(path),
		&:visited :global(path)
			fill: #eee
</style>
